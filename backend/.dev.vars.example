# Copy to .dev.vars for local development. Never commit .dev.vars. In production use: npx wrangler secret put NAME
ALLOWED_ORIGINS=http://localhost:8787
COOKIE_SAMESITE=Lax
ADMIN_SETUP_TOKEN=change-me-to-a-long-random-value
# Optional, only if you connect a card gateway (not connected yet):
# GATEWAY_NAME=your-gateway
# GATEWAY_API_KEY=
# GATEWAY_WEBHOOK_SECRET=
# WALLET_API_KEY=
# Optional order emails through Resend:
# RESEND_API_KEY=
# MAIL_FROM="GM Tools Hub <orders@yourdomain>"
